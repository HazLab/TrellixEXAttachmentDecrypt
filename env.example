# Copy to .env and fill in real values:  cp env.example .env
# .env is gitignored and never committed. Values shown are defaults/examples.

# ============================================================
# Trellix EX appliance  (REQUIRED)
# ============================================================
EX_BASE_URL=https://ex.example.com
EX_USERNAME=api_analyst
EX_PASSWORD=
# Verify the EX TLS certificate. Default false (EX appliances commonly use self-signed
# certs); set true in production with a trusted cert.
EX_VERIFY_TLS=false
# Optional X-FeClient-Token (provided by Trellix); leave blank if unused.
EX_CLIENT_TOKEN=
# Identifier the rescan endpoint expects in its path. The API doc names it
# "email_uuid"; some appliances accept the queue id. Flip to email_uuid if rescan
# returns an authorization/EMLMGR_RESCAN error despite valid permissions.
EX_RESCAN_ID_FIELD=queue_id
# HTTP timeout (seconds) for EX API calls — raise if EX is slow (ReadTimeout).
EX_TIMEOUT=60

# ============================================================
# What triggers the flow
# An alert fires the recovery flow only when its top-level "name" equals
# TRIGGER_ALERT_NAME (the riskware-object detection) AND one of its malware
# names exactly equals one of the comma-separated TRIGGER_MALWARE_NAMES.
# The encrypted-attachment custom policy emits CustomPolicy.MVX.<ext>.
# (Empty TRIGGER_MALWARE_NAMES disables triggering entirely.)
# ============================================================
TRIGGER_ALERT_NAME=RISKWARE_OBJECT
TRIGGER_MALWARE_NAMES=CustomPolicy.MVX.pdf,CustomPolicy.MVX.zip,CustomPolicy.MVX.docx,CustomPolicy.MVX.65066.PassExtractFailed

# ============================================================
# Outbound mail (SMTP)  (SMTP_HOST required)
# ============================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=attachment-help@example.com
# TLS mode: opportunistic (STARTTLS if offered, else plaintext) | starttls
# (require STARTTLS) | none (plaintext only) | ssl (implicit TLS/SMTPS, e.g. 465).
SMTP_TLS_MODE=opportunistic
# Verify the mail server's TLS cert. Default false for self-signed / lab CAs; set true
# in production with a trusted cert.
SMTP_VERIFY_TLS=false
# HELO/EHLO name sent to the server. Leave blank to use the OS hostname; set a
# fully-qualified name if the server rejects with "504 5.5.2 need FQDN".
SMTP_HELO_HOSTNAME=

# ============================================================
# Web server / one-time links
# ============================================================
# Public base URL used to build the password link emailed to recipients.
PUBLIC_BASE_URL=https://decrypt.example.com
WEB_HOST=0.0.0.0
# Port the app listens on. Change it here (restart to apply). In Docker, set WEB_PORT
# (container port) in this .env so the healthcheck follows it, and HOST_PORT for the
# published host port (compose maps HOST_PORT:WEB_PORT). Prefer this over the Settings
# UI for Docker so the mapping/healthcheck stay in sync.
WEB_PORT=8080
# HOST_PORT=8080   # Docker only: host port published by docker-compose (default 8080)
# Signs one-time tokens, UI sessions, and encrypts stored settings secrets.
# LEAVE BLANK to auto-generate a strong key on first run (persisted to ./secret.key,
# which is gitignored). Set an explicit long random string only if you want to manage
# it yourself or share it across instances. Changing it invalidates saved secrets.
SECRET_KEY=
# Admin password for the dashboard/settings UI. REQUIRED to leave "setup mode":
# until it is set, the service runs in first-run setup and the webhook returns 503.
# Can also be set from the UI on first run instead of here.
UI_PASSWORD=
# Link lifetime in seconds (default 24h).
TOKEN_TTL=86400

# ============================================================
# Webhook auth (EX HTTP notification -> this service)
# EX posts alerts using HTTP Basic auth; set matching credentials on the
# EX HTTP notification consumer. Optionally also restrict by source IP.
# At least one of (username/password) or (IP allowlist) must be set.
# ============================================================
WEBHOOK_USERNAME=ex-webhook
WEBHOOK_PASSWORD=change-me
# Optional comma-separated source-IP allowlist (empty = don't restrict by IP).
WEBHOOK_IP_ALLOWLIST=

# ============================================================
# Security / rate limiting (public POST endpoints)
# Per-IP, self-healing time windows: N attempts per window, then HTTP 429 until the
# window rolls off. Counters are in-memory, so a restart also clears them — there is
# no permanent lockout. Limit/window changes take effect on restart.
# ============================================================
# Admin sign-in: failed attempts per IP per window.
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW=900
# Recipient password form: submissions per (IP + link) per window.
FORM_RATE_LIMIT=10
FORM_RATE_WINDOW=300
# Trust the reverse proxy's X-Forwarded-For for the client IP. Enable ONLY when behind
# a proxy that sets it (otherwise the header is spoofable and defeats rate limiting).
TRUST_FORWARDED_FOR=false
# Reject webhook / form request bodies larger than this many bytes (DoS guard).
MAX_REQUEST_BYTES=1048576

# ============================================================
# Flow tuning
# ============================================================
# Max password retries before giving up (recommended 3-5).
MAX_PASSWORD_ATTEMPTS=3
# Recheck polling. A released/clean email sends no push, so it's found only by the poll
# — keep it eager so it doesn't linger in "rechecking". Seconds before the FIRST poll:
RECHECK_DELAY=10
# Steady-state seconds between later polls (the poll ramps up quickly, then settles here).
RECHECK_INTERVAL=30
# Number of polls before concluding "original left quarantine, no _RA = released".
RECHECK_MAX_ATTEMPTS=12
# Reconciliation: on startup (and every RECONCILE_INTERVAL seconds, 0 = startup only)
# query EX for recent trigger alerts and create any case missed while the app was down.
# Idempotent (dedup by queue id) — safe alongside EX's own notification retries. The
# look-back is an EX alerts-query duration (e.g. 1_hour, 24_hours, 48_hours).
RECONCILE_LOOKBACK=48_hours
RECONCILE_INTERVAL=1800
# Auto-retry of failed recipient emails (SMTP errors): cap + sweep interval.
NOTIFY_MAX_RETRIES=5
NOTIFY_RETRY_INTERVAL=300
# Auto-retry of failed EX resubmissions (rescan errors / EX briefly down).
RESUBMIT_MAX_RETRIES=5
RESUBMIT_RETRY_INTERVAL=120

# ============================================================
# Storage
# ============================================================
# Directory for persistent state that must survive restarts: the auto-generated
# secret.key and (when DB_URL is left at its default) the SQLite file. Point this at
# a mounted volume (Docker) or a writable folder (executable). Empty = working dir.
DATA_DIR=
DB_URL=sqlite:///trellix_decrypt.sqlite3

# ============================================================
# Bounce monitoring (optional) — poll the sender mailbox over IMAP for delivery
# failures (DSNs) and flip the case to "Bounced". Leave IMAP_HOST blank to disable.
# ============================================================
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_SSL=true
IMAP_MAILBOX=INBOX
BOUNCE_POLL_INTERVAL=120

# ============================================================
# Logging
# ============================================================
# INFO is fine; set DEBUG for verbose troubleshooting.
LOG_LEVEL=INFO
# Also write all logs — including EVERY HTTP request (uvicorn access log) — to this
# file (rotated). Handy for inspecting raw EX notifications. Set empty for console-only.
LOG_FILE=trellix_decrypt.log
LOG_FILE_MAX_BYTES=10000000
LOG_FILE_BACKUPS=5
