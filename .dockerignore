# Keep the build context small and free of secrets/local state.
.git
.gitignore
.github
.venv
venv
__pycache__
*.pyc
*.pyo
.pytest_cache
.ruff_cache
.coverage
htmlcov
tests
docs
documentation
build
dist
*.spec
*.egg-info
# Never ship secrets or local databases into the image.
.env
.env.*
secret.key
*.sqlite3
*.sqlite3-*
*.log
*.log.*
*:Zone.Identifier
